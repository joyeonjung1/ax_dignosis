# Vercel 프로젝트 > Settings > Environment Variables 에 같은 이름으로 넣으세요.
GEMINI_API_KEY=여기에_Gemini_API_키
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# 구글 시트 연결 스크립트 배포 후 나오는 웹 앱 주소 (https://script.google.com/macros/s/.../exec)
SHEET_WEBHOOK_URL=
# 선택: 비밀 문구를 쓰는 경우에만 (apps_script/Code.gs 의 SECRET 과 똑같이). 비워 두면 확인하지 않습니다.
SHEET_SECRET=
